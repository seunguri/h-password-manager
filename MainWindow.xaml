                </Grid> -->

            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 복사 성공 알림 오버레이 -->
        <Border x:Name="CopyToastBorder" Grid.ColumnSpan="2"
                Background="{DynamicResource PrimaryMutedBrush}" CornerRadius="6" Padding="16,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" IsHitTestVisible="False"
                Visibility="Collapsed" Opacity="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="CopyToastText" Text="비밀번호가 복사되었습니다"
                           Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
