<Window x:Class="PasswordProtector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordProtector"
        mc:Ignorable="d"
        Title="계정 관리" Height="700" Width="1400" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 헤더 새로고침·사이드바 보내기 등 공통 테두리 버튼 -->
            <!-- 설정 패널: 체크박스와 같은 줄 높이의 보내기 행 -->
            <Style x:Key="SettingsRowExportButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="ExportGlyphBox"
                                        Width="18" Height="18"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="0,0,8,0"
                                        SnapsToDevicePixels="True">
                                    <TextBlock Text="📤"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="복호화해서 내보내기"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ExportGlyphBox" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolbarOutlineButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 카드 내 복사 가능한 필드(아이디·비밀번호) 공통 스타일 -->
            <Style x:Key="CopyFieldBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 카드 필드 좌측 캡션(아이디/비밀번호/메모 라벨) -->
            <Style x:Key="CardFieldCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Width" Value="44"/>
            </Style>

            <!-- 카드 내 필드 구분선 -->
            <Style x:Key="CardDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="Margin" Value="0,12,0,10"/>
            </Style>

            <!-- 카드 필드 라벨(스택형) -->
            <Style x:Key="CardStackedCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="Margin" Value="0,0,0,3"/>
            </Style>

            <!-- 카드의 핵심 동작을 명확히 드러내는 SaaS형 버튼 -->
            <Style x:Key="CardPrimaryCopyButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="14,11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CopyButtonBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CopyButtonBorder" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CopyButtonBorder" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 계정 카드 템플릿 -->
            <DataTemplate x:Key="AccountCardTemplate">
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                        Margin="0,0,16,16" Width="320" Background="{DynamicResource CardBrush}" MinHeight="220">
                    <StackPanel Margin="18,18">
                        <!-- 서비스명 + 상태 + 메뉴 -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Border Width="30" Height="30" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Margin="0,0,10,0">
                                    <TextBlock Text="◆" Foreground="{Binding StatusColor}" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding ServiceName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    Tag="{Binding}" Click="CardMenu_Click"
                                    Foreground="{DynamicResource TextMutedBrush}" FontSize="16"
                                    Width="26" Height="26" Cursor="Hand" VerticalAlignment="Top"
                                    ToolTip="수정 (삭제는 수정창 하단에서)">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="MenuBorder" Background="Transparent" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="MenuBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- 비밀번호 복사가 카드의 단일·명확한 기본 행동 -->
                        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PASSWORD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding PasswordDisplay}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                                               FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            <Button Grid.Column="1" Content="&#xE890;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    Tag="{Binding}" Click="TogglePasswordVisibility_Click"
                                    Foreground="{DynamicResource TextMutedBrush}" FontSize="16" Width="30" Height="30" Padding="0" Cursor="Hand"
                                    ToolTip="비밀번호 임시 표시/숨김">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            </Grid>
                        </Border>

                        <Button Tag="{Binding}" Click="CopyPasswordButton_Click" Style="{StaticResource CardPrimaryCopyButtonStyle}"
                                ToolTip="비밀번호를 클립보드에 복사합니다. 복사 후 원하는 곳에서 Ctrl+V를 누르세요.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="비밀번호 복사" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- <TextBlock Text="복사 후 원하는 곳에서 Ctrl + V로 붙여넣으세요" FontSize="10.5" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/> -->

                        <!-- 아이디는 메모와 동일한 읽기 전용 정보 영역 -->
                        <StackPanel Visibility="{Binding Username, Converter={StaticResource StringToVisibilityConverter}}">
                            <Border Style="{StaticResource CardDividerStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="아이디" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Width="52" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Username}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>

                        <!-- 메모 (내용 있을 때만) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNotesContent}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Style="{StaticResource CardDividerStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="메모" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Width="52" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding NotesCardBody}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Notes}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 태그 (내용 있을 때만) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTags}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Style="{StaticResource CardDividerStyle}"/>
                            <ItemsControl ItemsSource="{Binding Tags, Converter={StaticResource TagsToListConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Converter={StaticResource TagColorConverter}}" CornerRadius="5" Padding="8,3" Margin="0,0,6,5">
                                            <TextBlock Text="{Binding}" Foreground="White" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- "새 계정 추가" 카드 템플릿 -->
            <DataTemplate x:Key="AddCardTemplate">
                <Border BorderThickness="0" CornerRadius="12" Margin="0,0,16,16"
                        Width="320" MinHeight="220" Background="{DynamicResource SurfaceBrush}"
                        Cursor="Hand" MouseLeftButtonDown="AddCard_Click"
                        ToolTip="새 계정 등록 (Ctrl+N)">
                    <Grid>
                        <Rectangle Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.4" StrokeDashArray="4 3"
                                   RadiusX="12" RadiusY="12"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="42" Height="42" Background="{DynamicResource PrimaryMutedBrush}" CornerRadius="12" HorizontalAlignment="Center">
                                <TextBlock Text="+" FontSize="24" FontWeight="Light" Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="새 계정 추가" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Text="새로운 로그인 정보를 안전하게 등록하세요" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <local:CardTemplateSelector x:Key="CardTemplateSelector"
                                        AccountTemplate="{StaticResource AccountCardTemplate}"
                                        AddCardTemplate="{StaticResource AddCardTemplate}"/>

            <!-- 사이드바 섹션 헤더 -->
            <Style x:Key="SidebarSectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>

            <!-- 사이드바 단축키 배지 -->
            <Style x:Key="ShortcutBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        
        <!-- Main Content -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="11" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource HeaderGradientStartColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource HeaderGradientEndColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource PrimaryTextBrush}"
                                      Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C7.58,14 4,16.69 4,20 L4,21 L20,21 L20,20 C20,16.69 16.42,14 12,14 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="계정 관리" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Account Manager" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔄 새로고침" Click="RefreshDashboard_Click"
                            Style="{StaticResource ToolbarOutlineButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="파일에서 계정·태그 목록을 다시 불러옵니다 (F5)"/>
                    <Button Content="+ 새 계정" Click="AddButton_Click"
                            Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            Padding="15,8" FontSize="14" BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
            
            <!-- Search Box -->
            <TextBox x:Name="SearchTextBox" Grid.Row="1" 
                     TextChanged="SearchTextBox_TextChanged"
                     KeyDown="SearchTextBox_KeyDown"
                     Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                     Padding="10,8" FontSize="14" Margin="0,0,0,15">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <Grid>
                                            <TextBlock x:Name="PlaceholderText" 
                                                       Text="🔍 서비스명, 아이디, 메모로 검색..."
                                                       Foreground="{DynamicResource TextSubtleBrush}"
                                                       Padding="{TemplateBinding Padding}"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Style>
            </TextBox>
            
            <!-- Tag Filters -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Width="15" Height="15" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1.3" CornerRadius="3" Margin="0,0,7,0"/>
                    <TextBlock Text="필터" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <!-- 전체(필터 해제) -->
                        <Border x:Name="AllFilterChip" CornerRadius="5" Padding="8,3" Margin="0,0,6,5"
                                Background="{DynamicResource PrimaryBrush}" Cursor="Hand" MouseLeftButtonDown="AllFilter_MouseLeftButtonDown">
                            <TextBlock Text="전체" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <ItemsControl x:Name="TagFilterControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Converter={StaticResource TagColorConverter}}"
                                            BorderBrush="Transparent" BorderThickness="1"
                                            CornerRadius="5" Padding="8,3" Margin="0,0,6,5"
                                            Cursor="Hand" MouseLeftButtonDown="TagFilter_MouseLeftButtonDown">
                                        <TextBlock Text="{Binding}" Foreground="White" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            
            <!-- Account Cards -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AccountCardsControl"
                              ItemTemplateSelector="{StaticResource CardTemplateSelector}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- Footer -->
            <TextBlock x:Name="AccountCountText" Grid.Row="4" Text="총 0개의 계정" 
                       Foreground="{DynamicResource TextSubtleBrush}" FontSize="12" Margin="0,15,0,0" HorizontalAlignment="Left"/>
        </Grid>
        
        <!-- Right Sidebar -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
                <!-- 사용 가이드 헤더 -->
                <TextBlock Text="💡 사용 가이드" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,18"/>

                <!-- 빠른 사용법 -->
                <TextBlock Text="빠른 사용법" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>

                <!-- 새 계정 추가 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7" Background="{DynamicResource SurfaceRaisedBrush}" Margin="0,0,10,0" VerticalAlignment="Top">
                        <TextBlock Text="📝" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="1. 창 열기" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource ShortcutBadgeStyle}">
                                <TextBlock Text="Ctrl + Shift + P" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="앱을 찾지 않아도 단축키로 바로 열기" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 계정 검색 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7" Background="{DynamicResource SurfaceRaisedBrush}" Margin="0,0,10,0" VerticalAlignment="Top">
                        <TextBlock Text="🔍" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="2.계정 검색" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource ShortcutBadgeStyle}">
                                <TextBlock Text="Ctrl + F" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="서비스명 또는 아이디로 검색" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 비밀번호 복사 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7" Background="{DynamicResource SurfaceRaisedBrush}" Margin="0,0,10,0" VerticalAlignment="Top">
                        <TextBlock Text="📋" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="3. 비밀번호 복사" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource ShortcutBadgeStyle}">
                                <TextBlock Text="Ctrl + C" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="맨 앞 계정의 비밀번호 복사" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,20,0,16"/>

                <!-- 원본 파일 위치 -->
                <TextBlock Text="📁 원본 파일 위치" Style="{StaticResource SidebarSectionHeaderStyle}" Margin="0,4,0,10"/>
                <TextBlock Text="로컬 PC에 안전하게 저장되며, 다음 경로에서 관리"
                           FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10"/>
                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="6" Padding="10,8"
                        Cursor="Hand" MouseLeftButtonDown="OpenFilePath_Click">
                    <TextBlock x:Name="FilePathText"
                               FontSize="11"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               ToolTip="클릭하면 파일 위치를 엽니다"/>
                </Border>

                <!-- 설정 -->
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,20,0,16"/>
                <TextBlock Text="⚙️ 설정" Style="{StaticResource SidebarSectionHeaderStyle}" Margin="0,0,0,14"/>
                
                <CheckBox x:Name="StartupCheckBox" 
                          Content="Windows 시작 시 자동 실행" 
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          FontSize="12"
                          Margin="0,0,0,12"
                          Checked="StartupCheckBox_Checked"
                          Unchecked="StartupCheckBox_Unchecked"
                          Loaded="StartupCheckBox_Loaded">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="CheckBoxBorder" 
                                                    Width="18" Height="18" 
                                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" 
                                                    CornerRadius="3"
                                                    Margin="0,0,8,0">
                                                <TextBlock x:Name="CheckMark" 
                                                           Text="✓" 
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           FontSize="12" 
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed"/>
                                            </Border>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <Button Click="ExportDecryptedIni_Click"
                        Style="{StaticResource SettingsRowExportButtonStyle}"
                        Margin="0,0,0,8"
                        ToolTip="비밀번호를 평문으로 풀어 INI 파일로 저장합니다."/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="118"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="테마"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="ThemeComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ThemeComboBoxStyle}"
                              SelectedValuePath="Tag"
                              SelectionChanged="ThemeComboBox_SelectionChanged"
                              Background="{DynamicResource SurfaceRaisedBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"
                              Padding="8,6"
                              FontSize="12">
                        <ComboBoxItem Content="Hanwha" Tag="Hanwha"/>
                        <ComboBoxItem Content="Dark" Tag="Dark"/>
                        <ComboBoxItem Content="Light" Tag="Light"/>
                    </ComboBox>
                </Grid>

                <!-- <Border Height="1" Background="#33373C" Margin="0,20,0,16"/> -->

                <!-- 상태 표시 -->
                <!-- <TextBlock Text="🕘 상태 표시" Style="{StaticResource SidebarSectionHeaderStyle}" Margin="0,4,0,14"/>

