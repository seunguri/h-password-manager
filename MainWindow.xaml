                        <TextBlock Text="7일 이내 만료" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusOrange}"/>
                        <TextBlock Text="비밀번호가 7일 이내 만료됩니다." FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
